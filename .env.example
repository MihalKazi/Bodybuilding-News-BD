# Public site URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://bodybuildingnewsbd.com

# Sanity CMS. Leave the project ID empty to use built-in sample content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity publish webhook (POST /api/revalidate)
REVALIDATE_SECRET=
